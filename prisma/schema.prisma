// BuildFlow data model.
// Quantities: Decimal(14,3). Money: Decimal(14,2). Work dates: @db.Date (Asia/Tbilisi calendar day).
// Timestamps: timestamptz, stored in UTC.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum OrgRole {
  ADMIN
  MEMBER
}

enum ProjectRole {
  REQUESTER
  BUYER
  RECEIVER
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

enum RequestStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  REJECTED
  PARTIALLY_ORDERED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum OrderStatus {
  ACTIVE
  CANCELLED
}

enum CancellationStatus {
  PENDING
  CONFIRMED
  REJECTED
  WITHDRAWN
}

enum CancellationSide {
  REQUESTER
  BUYER
}

enum Currency {
  GEL
  USD
  EUR
}

// ─── Organization and users ──────────────────────────────────────────────────

model Organization {
  id         String   @id @default(cuid())
  name       String
  // Per-organization counters for human-readable numbers (incremented in a transaction).
  requestSeq Int      @default(0)
  orderSeq   Int      @default(0)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  users     User[]
  projects  Project[]
  suppliers Supplier[]
  requests  PurchaseRequest[]
  orders    PurchaseOrder[]
  events    AuditEvent[]
  imports   RequestImport[]
}

// Better Auth core table "user" plus BuildFlow fields.
model User {
  id                 String   @id
  name               String
  email              String   @unique
  emailVerified      Boolean  @default(false)
  image              String?
  organizationId     String
  orgRole            OrgRole  @default(MEMBER)
  isActive           Boolean  @default(true)
  // Set when an admin creates the account or resets the password.
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions     Session[]
  accounts     Account[]
  memberships  ProjectMembership[]

  requestsAuthored       PurchaseRequest[]  @relation("RequestAuthor")
  requestsReviewed       PurchaseRequest[]  @relation("RequestReviewer")
  ordersCreated          PurchaseOrder[]
  receipts               Receipt[]
  events                 AuditEvent[]
  imports                RequestImport[]
  cancellationsRequested ItemCancellation[] @relation("CancellationRequestedBy")
  cancellationsDecided   ItemCancellation[] @relation("CancellationDecidedBy")

  @@index([organizationId])
}

// ─── Better Auth tables ──────────────────────────────────────────────────────

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  address        String
  status         ProjectStatus @default(ACTIVE)
  archivedAt     DateTime?     @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  memberships  ProjectMembership[]
  requests     PurchaseRequest[]
  events       AuditEvent[]
  imports      RequestImport[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, status])
}

model ProjectMembership {
  id        String        @id @default(cuid())
  projectId String
  userId    String
  roles     ProjectRole[]
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ─── Requests ────────────────────────────────────────────────────────────────

model PurchaseRequest {
  id              String        @id @default(cuid())
  organizationId  String
  number          Int
  projectId       String
  authorId        String
  desiredDate     DateTime?     @db.Date
  priority        Priority      @default(NORMAL)
  note            String?
  status          RequestStatus @default(DRAFT)
  submittedAt     DateTime?     @db.Timestamptz(3)
  reviewedAt      DateTime?     @db.Timestamptz(3)
  reviewedById    String?
  rejectionReason String?
  cancelReason    String?
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Composite FK: the project must belong to the same organization.
  project      Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  author       User            @relation("RequestAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reviewedBy   User?           @relation("RequestReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  items        RequestItem[]
  orders       PurchaseOrder[]
  importInfo   RequestImport?

  @@unique([organizationId, number])
  @@unique([id, organizationId])
  @@index([projectId, status])
  @@index([organizationId, status, createdAt])
}

model RequestItem {
  id               String   @id @default(cuid())
  requestId        String
  position         Int
  name             String
  spec             String?
  // What the requester asked for.
  quantity         Decimal  @db.Decimal(14, 3)
  // What may be ordered, when the buyer changed it (packaging) or a remainder was cancelled.
  // Null means "as requested".
  approvedQuantity Decimal? @db.Decimal(14, 3)
  unit             String
  note             String?

  request       PurchaseRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  cancellations ItemCancellation[]

  @@unique([requestId, position])
}

// ─── Suppliers and orders ────────────────────────────────────────────────────

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  taxId          String?
  phone          String?
  email          String?
  note           String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  orders       PurchaseOrder[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
}

model PurchaseOrder {
  id                  String      @id @default(cuid())
  organizationId      String
  number              Int
  requestId           String
  supplierId          String
  currency            Currency    @default(GEL)
  plannedDeliveryDate DateTime?   @db.Date
  status              OrderStatus @default(ACTIVE)
  cancelReason        String?
  createdById         String
  createdAt           DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  // Composite FKs: request and supplier must belong to the same organization.
  request      PurchaseRequest @relation(fields: [requestId, organizationId], references: [id, organizationId], onDelete: Restrict)
  supplier     Supplier        @relation(fields: [supplierId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy    User            @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items        OrderItem[]
  receipts     Receipt[]

  @@unique([organizationId, number])
  @@index([requestId])
  @@index([supplierId])
  @@index([organizationId, status, plannedDeliveryDate])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  requestItemId String
  quantity      Decimal   @db.Decimal(14, 3)
  // Per-unit price can need sub-tetri precision; totals are rounded to 2 decimals.
  unitPrice     Decimal   @db.Decimal(14, 4)
  note          String?
  // Closed short: the supplier delivers no more. The line then counts as ordered only up to
  // what was received, and the rest returns to the request.
  closedAt      DateTime? @db.Timestamptz(3)
  closeReason   String?

  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestItem  RequestItem   @relation(fields: [requestItemId], references: [id], onDelete: Restrict)
  receiptItems ReceiptItem[]

  @@unique([orderId, requestItemId])
  @@index([requestItemId])
}

// ─── Receipts ────────────────────────────────────────────────────────────────

model Receipt {
  id           String   @id @default(cuid())
  orderId      String
  receivedOn   DateTime @db.Date
  receivedById String
  note         String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  order      PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receivedBy User          @relation(fields: [receivedById], references: [id], onDelete: Restrict)
  items      ReceiptItem[]

  @@index([orderId])
}

model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  orderItemId String
  // Negative values are corrections; confirmed rows are never edited in place.
  quantity    Decimal @db.Decimal(14, 3)
  correctsId  String?
  note        String?

  receipt     Receipt       @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem   OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  corrects    ReceiptItem?  @relation("ReceiptCorrection", fields: [correctsId], references: [id], onDelete: Restrict)
  corrections ReceiptItem[] @relation("ReceiptCorrection")

  @@index([orderItemId])
}

// ─── WhatsApp text import ────────────────────────────────────────────────────

// Technical metadata of a confirmed import. The pasted text itself is never stored:
// only a SHA-256 hash of its canonical form, used to warn about importing the same text twice.
model RequestImport {
  id               String   @id @default(cuid())
  organizationId   String
  projectId        String
  userId           String
  requestId        String   @unique
  // Generated when the preview is shown; a repeated confirm returns the same draft.
  idempotencyKey   String
  textHash         String
  lineCount        Int
  skippedLineCount Int
  itemCount        Int
  // Items that the parser flagged for clarification in the preview.
  flaggedItemCount Int
  // The user confirmed although the same text had been imported before.
  repeatConfirmed  Boolean  @default(false)
  // Request item position → original line number (no text).
  sourceLines      Json?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project         @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  user         User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  request      PurchaseRequest @relation(fields: [requestId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([requestId, organizationId])
  @@unique([organizationId, idempotencyKey])
  @@index([projectId, textHash])
}

// ─── Audit log ───────────────────────────────────────────────────────────────

model AuditEvent {
  id             String   @id @default(cuid())
  // Monotonic insertion order; timestamps can tie within one transaction.
  seq            BigInt   @unique @default(autoincrement())
  organizationId String
  projectId      String?
  actorId        String?
  entityType     String
  entityId       String
  action         String
  changes        Json?
  reason         String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, seq])
  @@index([organizationId, createdAt])
  @@index([projectId, seq])
}

// Cancelling the undelivered remainder of a request item needs both sides: the requester side
// (request author) and the buyer side. One side asks, a different person on the other side
// confirms or rejects. At most one PENDING row per item (partial unique index in the migration).
model ItemCancellation {
  id                String             @id @default(cuid())
  requestItemId     String
  status            CancellationStatus @default(PENDING)
  side              CancellationSide
  reason            String
  requestedById     String
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  decidedById       String?
  decidedAt         DateTime?          @db.Timestamptz(3)
  decisionReason    String?
  // Remainder (approved minus received) when the cancellation was confirmed.
  cancelledQuantity Decimal?           @db.Decimal(14, 3)

  requestItem RequestItem @relation(fields: [requestItemId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("CancellationRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User?       @relation("CancellationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([requestItemId, status])
  @@index([status])
}

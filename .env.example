# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL connection string.
DATABASE_URL="postgresql://buildflow:CHANGE_ME@localhost:5432/buildflow?schema=public"

# Separate database for automated tests (wiped by the test suite).
TEST_DATABASE_URL="postgresql://buildflow:CHANGE_ME@localhost:5432/buildflow_test?schema=public"

# Random secret, at least 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET="CHANGE_ME"

# Public URL of the app (https://siteflow.win in production).
BETTER_AUTH_URL="http://localhost:3000"
